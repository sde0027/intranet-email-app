# Required: replace with a long, random secret before running the server.
SESSION_SECRET=replace-this-with-a-long-random-secret

# Local development defaults
PORT=3000
COOKIE_SECURE=false

# Login protection: maximum attempts from one IP within the configured window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Optional external company portal links (frontend)
VITE_ATTENDANCE_PORTAL_URL=
VITE_INVENTORY_PORTAL_URL=
